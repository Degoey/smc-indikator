# Exchange API credentials (never commit the real .env)
# NOTE: Currently configured for Indodax. To switch to Mobee, replace the
# values below with Mobee credentials and update src/indodax/* accordingly.
INDODAX_API_KEY=your_api_key_here
INDODAX_SECRET_KEY=your_secret_key_here

# API configuration
INDODAX_API_VERSION=v2
INDODAX_BASE_URL=https://api.indodax.com

# Trading pair for the bot, e.g. BTCIDR, ETHIDR, BTCUSDT
TRADING_PAIR=BTCIDR

# Risk / sizing
MAX_RISK_PCT=2

# Safety: DRY_RUN=true by default. Set to false only after thorough testing.
DRY_RUN=true
BOT_ENABLED=false

# Optional: cancel bot-placed orders on graceful shutdown
CANCEL_ON_SHUTDOWN=false

# Server
PORT=8787
# Allow all origins so the Android app (Capacitor WebView sends
# origin "capacitor://localhost" or "http://localhost") can reach the API.
# For production, replace * with your frontend/domain URL.
CORS_ORIGIN=*

# Fine-tuning (milliseconds)
RECV_WINDOW_MS=5000
TIMEOUT_MS=10000
BOT_INTERVAL_MS=60000
BOT_CLOCK_SKEW_INTERVAL_MS=300000

# Logging
LOG_LEVEL=info
